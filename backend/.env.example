###############################################################################
# Kabeer — The Ethnic Store · backend configuration
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# The server validates this file at boot and refuses to start if anything is
# missing or malformed.
###############################################################################

# --- runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# --- database (Supabase PostgreSQL) -----------------------------------------
# Both strings come from Supabase → Connect → ORMs / Connection string.
#
#   DATABASE_URL → "Session pooler" (port 5432) - used by the running API
#   DIRECT_URL   → "Session pooler" (port 5432) - used by migrations
#
# Both use the SESSION pooler because this API is one long-running process with
# a stable connection pool. Supabase's transaction pooler (6543) is built for
# serverless, where every function instance is short-lived; it checks out a
# backend per transaction, which measured ~5x slower per query here (905ms vs
# 180ms against a database in another region).
#
# If you ever run this on serverless or scale to many instances, switch
# DATABASE_URL to :6543 with pgbouncer=true&connection_limit=1 and accept that
# per-query cost - session mode holds a real backend per pooled connection.
#
# Do NOT use the "Direct connection" string (db.<project-ref>.supabase.co). It
# resolves to IPv6 only, so on a network without IPv6 it fails with
# "P1001: Can't reach database server". Both pooler hostnames are IPv4.
#
# The username on pooler connections is postgres.<project-ref>, not postgres.
# connect_timeout is raised because Prisma's 5s default is tight when the
# database sits in a distant region. Percent-encode any of @ : / ? # % & in the
# password.
#
# connection_limit is the size of Prisma's pool. Never 1 on a long-running
# server - that serializes every concurrent request behind one connection.
#
# Pick a region close to your customers. Latency is paid on every round trip,
# so a distant database slows down every page. Measured from India:
# ap-south-1 75ms, ap-southeast-1 119ms, ap-northeast-1 196ms. A project's
# region cannot be changed after it is created.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?connection_limit=10&connect_timeout=30"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?connect_timeout=30"

# --- web origins ------------------------------------------------------------
# FRONTEND_URL is the storefront and is ALWAYS allowed to call this API.
# CORS_ORIGINS adds any others (a second domain, preview deployments) and is
# comma-separated. Together they are the only origins accepted on
# state-changing requests, which is the CSRF defence.
#
# A trailing slash or path is stripped automatically - an origin is only
# scheme + host + port. But "www.example.com" and "example.com" are DIFFERENT
# origins to a browser: redirect one to the other, or list both.
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- authentication ---------------------------------------------------------
# At least 32 characters. Generate with: openssl rand -base64 48
# Rotating this signs every user out.
AUTH_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
SESSION_TTL_DAYS=30
# "lax" when the storefront and API share a site; "none" (with COOKIE_SECURE=true)
# when they are on different domains.
COOKIE_SAMESITE=lax
# Defaults to true in production. Set explicitly only to override.
# COOKIE_SECURE=true
# Set when the API and storefront share a parent domain, e.g. .kabeer.example
# COOKIE_DOMAIN=

# --- pricing rules (paise / percent) ----------------------------------------
TAX_PERCENT=5
SHIPPING_FLAT=0
FREE_SHIPPING_THRESHOLD=0
# Unpaid checkouts release their stock reservation after this many minutes.
ORDER_RESERVATION_MINUTES=30

# --- payments (Razorpay) ----------------------------------------------------
# Leave blank to run without online payments; checkout then reports that
# payments are unavailable instead of pretending to succeed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Razorpay Dashboard → Settings → Webhooks. Required for webhook handling.
RAZORPAY_WEBHOOK_SECRET=

# --- media (Supabase Storage) -----------------------------------------------
# Supabase → Project Settings → API Keys → Secret keys. Use the secret key
# (sb_secret_…), not the publishable one. This is a server-only secret: it
# bypasses row-level security and must never reach the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=product-media

# Legacy alternative, only for a project still on the old keys. Supabase is
# retiring service_role/anon JWTs through 2026 — migrate to SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=

# --- email (Resend) ----------------------------------------------------------
# Required for account verification and password reset; without it those flows
# refuse with a clear message, and order/payment receipts are skipped.
#
# EMAIL_FROM must be an address on a domain you have verified in Resend
# (Resend -> Domains). Sending from an unverified domain is rejected.
RESEND_API_KEY=
EMAIL_FROM="Kabeer <orders@your-domain.com>"
EMAIL_REPLY_TO="support@your-domain.com"
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# --- limits -----------------------------------------------------------------
MAX_UPLOAD_BYTES=5242880
MAX_BODY_BYTES=1048576

# --- first administrator (read only by `npm run db:seed`) --------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Store Owner
