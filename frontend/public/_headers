# Vite fingerprints everything in /assets, so those files can never change
# under a given name and are safe to cache permanently.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The HTML entry point must always be revalidated, otherwise a deploy would
# not reach browsers holding a cached copy.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
