# Frontend configuration.
#
# Vite only exposes VITE_-prefixed variables to the browser, so NO SECRET may be
# placed in this file or in .env. Everything here ends up in the built bundle.

# Base URL of the API.
# Leave unset in development — the dev server proxies /api to the backend so the
# session cookie stays same-origin. Set it for production builds, e.g.
# VITE_API_URL=https://api.your-domain.com/api
# VITE_API_URL=

# Where `npm run dev` proxies /api during development.
# VITE_DEV_API_PROXY=http://localhost:4000
